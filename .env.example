# fd-bot configuration (copy to .env)
# Bind
PORT=8791
HOST=127.0.0.1

# Binding store. postgres://user:pass@host:port/db  (default: in-memory, dev only)
# In-memory loses bindings on restart — acceptable for a smoke run, never for a deployment.
# FD_BOT_DATABASE_URL=postgres://fd:...@127.0.0.1:30432/fd_bot

# Persistence for the durable acceptance queue (must survive a pod roll).
FD_BOT_DATA_DIR=./data

# Secrets
# HMAC key for media tickets. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FD_BOT_MEDIA_SECRET=
# Encrypts binding credentials at rest. Same generation recipe.
FD_BOT_CREDENTIAL_KEY=

# Subscriber delivery
FD_BOT_DELIVERY_TIMEOUT_MS=10000
FD_BOT_DELIVERY_MAX_ATTEMPTS=8

# Callback URL base used when a binding is created in callback mode.
# FD_BOT_PUBLIC_BASE_URL=https://bot.finddatatech.cloud
